#!/bin/bash

# shellcheck source=../scripts/helpers/index.sh
source /usr/local/bin/helpers/index.sh

function _main() {
  _require_n_parameters_or_print_usage 1 "${@}"

  local DOMAIN="${1}"

  _delete_relayhost
}

function __usage() {
  printf '%s' "${PURPLE}delrelayhost${RED}(${YELLOW}8${RED})

${ORANGE}USAGE${RESET}
    ./setup.sh relay del-domain <SENDER DOMAIN>

${ORANGE}OPTIONS${RESET}
    ${BLUE}Generic Program Information${RESET}
        help       Print the usage information.

${ORANGE}DESCRIPTION${RESET}
    Remove the relay-host mapping (or exclusion) configured for the provided
    sender domain, as added via 'relay add-domain' or 'relay exclude-domain'.

${ORANGE}EXAMPLES${RESET}
    ${LWHITE}./setup.sh relay del-domain example.com${RESET}
        Removes any relay-host mapping or opt-out entry configured for
        '@example.com' senders.

${ORANGE}EXIT STATUS${RESET}
    Exit status is 0 if command was successful. If wrong arguments are provided
    or arguments contain errors, the script will exit early with exit status 1.

"
}

# Config is for sender dependent relay-host mapping,
# mirrors `addrelayhost` / `excluderelaydomain` (see `helpers/relay.sh`).
function _delete_relayhost() {
  local SENDER="@${DOMAIN}"
  local DATABASE_RELAY='/tmp/docker-mailserver/postfix-relaymap.cf'

  _db_entry_remove "${DATABASE_RELAY}" "${SENDER}"
}

_main "${@}"
