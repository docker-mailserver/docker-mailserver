#!/bin/bash

# shellcheck source=../scripts/helpers/index.sh
source /usr/local/bin/helpers/index.sh

function _main() {
  _require_n_parameters_or_print_usage 1 "${@}"

  local DOMAIN="${1}"

  _delete_relayhost_credentials
}

function __usage() {
  printf '%s' "${PURPLE}delsaslpassword${RED}(${YELLOW}8${RED})

${ORANGE}USAGE${RESET}
    ./setup.sh relay del-auth <SENDER DOMAIN>

${ORANGE}OPTIONS${RESET}
    ${BLUE}Generic Program Information${RESET}
        help       Print the usage information.

${ORANGE}DESCRIPTION${RESET}
    Remove the relay-host credentials configured for the provided sender
    domain, as added via 'relay add-auth'.

${ORANGE}EXAMPLES${RESET}
    ${LWHITE}./setup.sh relay del-auth example.com${RESET}
        Removes the relay-host credentials configured for '@example.com'
        senders.

${ORANGE}EXIT STATUS${RESET}
    Exit status is 0 if command was successful. If wrong arguments are provided
    or arguments contain errors, the script will exit early with exit status 1.

"
}

# Config is for sender dependent relay-host auth, mirrors `addsaslpassword`
# (see `helpers/relay.sh`).
function _delete_relayhost_credentials() {
  local SENDER="@${DOMAIN}"
  local DATABASE_PASSWD='/tmp/docker-mailserver/postfix-sasl-password.cf'

  _db_entry_remove "${DATABASE_PASSWD}" "${SENDER}"
}

_main "${@}"
