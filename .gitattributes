# Text files are LF in the repository and in every checkout: files below `rootfs/` and `test/`
# end up in containers, where CRLF breaks scripts and configs.
# Documentation: https://git-scm.com/docs/gitattributes
* text=auto eol=lf

*.ico  binary
*.png  binary
*.webp binary
*.woff binary
*.svg  -diff

.editorconfig  export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
.gitkeep       export-ignore
.gitmodules    export-ignore
